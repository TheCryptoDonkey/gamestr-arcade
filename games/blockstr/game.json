{
  "manifestVersion": 2,
  "name": "blockstr",
  "tagline": "Nostr-powered Tetris - stack blocks, top the chain",
  "url": "https://blockstr.io/",
  "gameId": "blockstr",
  "order": 7,
  "accent": "#8b5cf6",
  "inputModes": ["gamepad", "keyboard"],
  "controller": { "adapter": "native" },
  "controlHints": [
    "D-PAD / LEFT STICK = MOVE",
    "A / X = ROTATE · B / Y = HARD DROP",
    "RT / DOWN = SOFT DROP · START = PAUSE"
  ],
  "network": "required",
  "capabilities": { "nostrSign": true, "walletPay": false, "persistentStorage": false, "externalNavigation": false },
  "allowedOrigins": ["https://blockstr.io"]
}
